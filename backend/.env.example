# ==============================================================================
# PRAMAANX - Environment Variables Configuration
# ==============================================================================
# Copy this file to `backend/.env` and fill in your values.
# NEVER commit `backend/.env` or secrets to version control.

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
# Supabase Project Base URL (e.g. https://<project-ref>.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Service Role Secret Key (Server-side ONLY; never expose to frontend)
SUPABASE_SECRET_KEY=your_supabase_secret_key_here

# Supabase Publishable / Anon Key (Frontend / public client access)
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# Supabase PostgreSQL Connection String
# NOTE: For cloud/production and networks without native IPv6, use the
# Supabase Connection Pooler URL (aws-1 or aws-0) in session mode (5432) or transaction mode (6543):
# Format: postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your_password@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require

# ------------------------------------------------------------------------------
# Security & CORS (Render / Cloud Deployment)
# ------------------------------------------------------------------------------
# Comma-separated origins allowed to make API requests (e.g., your Vercel domain)
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# ------------------------------------------------------------------------------
# Local Vault & Offline Fallback (Optional)
# ------------------------------------------------------------------------------
# If SUPABASE_DB_URL is omitted or empty, PRAMAANX will automatically
# and seamlessly fall back to local SQLite at PRAMAANX_DB_PATH.
# PRAMAANX_DATA_DIR=backend/data
# PRAMAANX_DB_PATH=backend/data/pramaanx.db
# PRAMAANX_TEMP_DIR=backend/temp

